# Copy to .env locally — never commit real secrets.
# Used by docker compose and local runs.

# PostgreSQL
POSTGRES_USER=modelaflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=modelaflow
POSTGRES_PORT=5432

# Connection string for API outside Compose (optional)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=modelaflow;Username=modelaflow;Password=CHANGE_ME

# Auth (API) — override in Production (signing key ≥ 32 chars)
AUTH_JWT_SIGNING_KEY=DEV_ONLY_CHANGE_ME_ModelaFlow_Auth_Signing_Key_32+
Auth__JwtSigningKey=DEV_ONLY_CHANGE_ME_ModelaFlow_Auth_Signing_Key_32+
Auth__CookieName=mf_auth

# CORS (browser origin for the web app)
CORS_ORIGINS=http://localhost:3000
Cors__Origins=http://localhost:3000

# Ports published on the host
API_PORT=5074
WEB_PORT=3000
ASPNETCORE_ENVIRONMENT=Development
Database__ApplyMigrations=true

# Next.js — URL the *browser* uses to call the API
NEXT_PUBLIC_API_URL=http://localhost:5074
NEXT_PUBLIC_API_BASE_URL=http://localhost:5074
